# Dependencies
node_modules/
*/node_modules/

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
server.log

# Test coverage
coverage/
.nyc_output/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.docker/
docker-compose.override.yml

# Database
mysql-data/
*.sqlite
*.db

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Cache
.cache/
.eslintcache
.stylelintcache

# Misc
cookies*.txt
query
*.pid