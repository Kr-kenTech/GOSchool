# ==========================================
# GOSchool — Environment Variables Template
# Copie para .env e preencha os valores
# ==========================================

# ----------------------------------------
# Application
# ----------------------------------------
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ----------------------------------------
# MySQL Database
# ----------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=banco_goschool
MYSQL_USER=goschool
MYSQL_PASSWORD=goschool123

# ----------------------------------------
# MongoDB Database
# ----------------------------------------
MONGO_DB=banco_goschool
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123

# ----------------------------------------
# JWT Authentication
# ----------------------------------------
# IMPORTANT: Gere secrets seguros para produção!
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----------------------------------------
# Internal Service Communication (HMAC)
# ----------------------------------------
# IMPORTANT: Gere secrets seguros para produção!
INTERNAL_SHARED_SECRET=your-internal-shared-secret-change-in-production-min-32-chars
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# ----------------------------------------
# Google OAuth (RS256)
# ----------------------------------------
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ----------------------------------------
# Email (Nodemailer)
# ----------------------------------------
# Configure seu provedor SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@goschool.edu.br

# ----------------------------------------
# LGPD/ECA Consent
# ----------------------------------------
CONSENT_EXPIRY_HOURS=72

# ----------------------------------------
# Demo Mode (desenvolvimento)
# ----------------------------------------
DEMO_MODE=false